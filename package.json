    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.11.0 <25"
